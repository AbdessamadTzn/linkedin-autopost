# Copier en .env pour un usage local (ne jamais committer .env).
# En CI, ces valeurs proviennent des secrets GitHub Actions.

# Clé API Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Jeton d'accès LinkedIn (à régénérer tous les 60 jours, voir README)
LINKEDIN_TOKEN=

# Identifiant de personne LinkedIn (champ "sub" de /v2/userinfo)
# Obtenu via : python scripts/get_person_id.py
LINKEDIN_PERSON_ID=
